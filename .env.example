NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
NESSIE_ACCOUNT_ID=
# alex-demo runs the explicit fictional Alex profile through the finance engine.
# Set nessie to require the configured sandbox account; failures never fall back.
MOVIN_DATA_MODE=alex-demo
FINANCE_SAFETY_BUFFER_CENTS=50000
# Optional absolute JSON file containing explicit future ScheduledCashFlow entries.
MOVIN_CASH_FLOWS_FILE=
# Comma-separated bills replaced by the proposed lease (avoid double counting).
FINANCE_EXCLUDED_BILL_IDS=
# Optional: override only if your hackathon uses a different Nessie host.
NESSIE_BASE_URL=https://api.nessieisreal.com

# Inclusive observation-window start for the finance adapter.
FINANCE_HISTORY_START=

# Local sandbox bridge (generate a random token; never commit its actual value)
MOVIN_BRIDGE_TOKEN=
FINANCE_AS_OF_DATE=2026-10-03
MOVIN_PORT=3101
# Private Fetch identity seed; keep stable and never commit the actual value.
MOVIN_AGENT_SEED=
# Fetch ASI key for understanding apartment questions.
ASI1_API_KEY=

# Optional stable secret for encrypted 10-minute browser chat sessions.
MOVIN_CHAT_SECRET=
